{
  "uid": "wsl-gpu-lab",
  "title": "WSL2 GPU laboratory - measured and simulated sources",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "wsl2",
    "laboratory"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "type": "custom",
        "query": "fixture,wsl",
        "current": {
          "text": "fixture",
          "value": "fixture"
        },
        "options": [
          {
            "text": "fixture",
            "value": "fixture",
            "selected": true
          },
          {
            "text": "wsl",
            "value": "wsl",
            "selected": false
          }
        ]
      },
      {
        "name": "gpu",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "lab-prometheus"
        },
        "query": "label_values(lab_gpu_field_available{source=~\"$source\"},gpu)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Evidence and interpretation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Select source `fixture` for SIMULATED values or `wsl` for live mapped-driver observations.** No-data is not zero. GPU byte totals are device-reported; 64 GB host memory is not a 64 GB GPU allocation budget. Synthetic CPU request panels are pipeline exercises, not model measurements. Rate and p95 panels need several scrapes and requests."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU busy ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_gpu_busy_ratio{source=~\"$source\",gpu=~\"$gpu\"}",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU memory bytes",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_gpu_memory_used_bytes{source=~\"$source\",gpu=~\"$gpu\"}",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPU memory pressure",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab:gpu_memory_used:ratio{source=~\"$source\",gpu=~\"$gpu\"}",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_gpu_temperature_celsius{source=~\"$source\",gpu=~\"$gpu\"}",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPU power",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_gpu_power_watts{source=~\"$source\",gpu=~\"$gpu\"}",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU SM clock",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_gpu_sm_clock_hertz{source=~\"$source\",gpu=~\"$gpu\"}",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Field availability: 0 means unavailable",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_gpu_field_available{source=~\"$source\",gpu=~\"$gpu\"}",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Scrape health: 1 means endpoint reachable",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"gpu\"}",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Collector age",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - lab_exporter_last_poll_timestamp_seconds",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "SYNTHETIC CPU requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lab_demo_requests_total[1m]))",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "SYNTHETIC CPU p95 handler latency",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(lab_demo_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "SYNTHETIC CPU error fraction",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lab_demo_requests_total{status=\"503\"}[1m])) / sum(rate(lab_demo_requests_total[1m]))",
          "legendFormat": "{{field}} {{gpu}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
